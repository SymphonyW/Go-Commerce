# Shared dependencies
DB_DSN=root:password@tcp(127.0.0.1:3307)/ecommerce?charset=utf8mb4&parseTime=True&loc=Local
REDIS_ADDR=127.0.0.1:6379
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
EVENT_EXCHANGE=ecommerce.events
AUTO_MIGRATE_ENABLED=false

# Observability
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317

# API gateway
HTTP_ADDR=:8080
AUTH_SERVICE_ADDR=localhost:50051
PRODUCT_SERVICE_ADDR=localhost:50052
ORDER_SERVICE_ADDR=localhost:50053
CART_SERVICE_ADDR=localhost:50054
MERCHANT_SERVICE_ADDR=localhost:50055
PAYMENT_SERVICE_ADDR=localhost:50056
GATEWAY_GRPC_TIMEOUT=3s
CORS_ALLOWED_ORIGINS=http://localhost:5173

# gRPC service listeners
AUTH_GRPC_ADDR=:50051
PRODUCT_GRPC_ADDR=:50052
ORDER_GRPC_ADDR=:50053
CART_GRPC_ADDR=:50054
MERCHANT_GRPC_ADDR=:50055
PAYMENT_GRPC_ADDR=:50056

# Health endpoints
AUTH_HEALTH_ADDR=:8081
PRODUCT_HEALTH_ADDR=:8082
ORDER_HEALTH_ADDR=:8083
CART_HEALTH_ADDR=:8084
MERCHANT_HEALTH_ADDR=:8085
PAYMENT_HEALTH_ADDR=:8086
NOTIFICATION_HEALTH_ADDR=:8087
OUTBOX_HEALTH_ADDR=:8088

# Internal service calls and workers
SERVICE_GRPC_TIMEOUT=3s
ORDER_PAYMENT_TIMEOUT_MINUTES=15
OUTBOX_POLL_INTERVAL=5s
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_RETRY=5
OUTBOX_RETRY_BASE_DELAY=1s
OUTBOX_LEASE_DURATION=30s
# OUTBOX_WORKER_ID=local-outbox-worker
